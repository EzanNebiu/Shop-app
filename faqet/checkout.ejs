<%- include('navbar.ejs', { perdoruesi: perdoruesi || false, isLoggedIn: isLoggedIn || false }) %>

<div class="checkout-container">
    <% if (!isLoggedIn) { %>
        <div class="login-required">
            <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#0891b2" stroke-width="1.5">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <h2>Kyçuni për të vazhduar</h2>
            <p>Ju lutemi kyçuni ose regjistrohuni për të përfunduar blerjen tuaj</p>
            <div class="auth-buttons">
                <a href="/login" class="btn-login">Kyçu</a>
                <a href="/register" class="btn-register">Regjistrohu</a>
            </div>
        </div>
    <% } else { %>
        <div class="checkout-header">
            <h1>Checkout</h1>
            <p>Konfirmoni porosinë tuaj</p>
        </div>

        <div class="checkout-content">
            <div class="checkout-items" id="checkoutItems">
                <!-- Items will be loaded here -->
            </div>

            <div class="checkout-summary">
                <div class="summary-card">
                    <h3>Informacioni i Porosis</h3>
                    
                    <div class="user-info">
                        <div class="info-row">
                            <span class="label">Emri:</span>
                            <span class="value"><%= perdoruesi.emri %></span>
                        </div>
                        <div class="info-row">
                            <span class="label">Email:</span>
                            <span class="value"><%= perdoruesi.email %></span>
                        </div>
                    </div>

                    <div class="summary-divider"></div>

                    <div class="order-summary">
                        <div class="summary-row">
                            <span>Nëntotali</span>
                            <span id="subtotal">€0.00</span>
                        </div>
                        <div class="summary-row">
                            <span>Transporti</span>
                            <span>FALAS</span>
                        </div>
                        <div class="summary-divider"></div>
                        <div class="summary-row total">
                            <span>Totali</span>
                            <span id="total">€0.00</span>
                        </div>
                    </div>

                    <button class="place-order-btn" id="placeOrderBtn">
                        <span>Perfundo Porosinë</span>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="M5 12h14M12 5l7 7-7 7"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    <% } %>
</div>

<script>
    <% if (isLoggedIn) { %>
    function loadCheckout() {
        const cart = JSON.parse(localStorage.getItem('cart') || '[]');
        
        if (cart.length === 0) {
            window.location.href = '/';
            return;
        }

        const checkoutItems = document.getElementById('checkoutItems');
        let html = '';
        let subtotal = 0;

        cart.forEach(item => {
            const itemTotal = item.cmimi * item.sasia;
            subtotal += itemTotal;

            html += `
                <div class="checkout-item">
                    <div class="item-image" style="background-image: url('${item.foto}');"></div>
                    <div class="item-info">
                        <h4>${item.emri}</h4>
                        <p>Sasia: ${item.sasia}</p>
                        <p class="item-price">€${item.cmimi} × ${item.sasia}</p>
                    </div>
                    <div class="item-total">€${itemTotal.toFixed(2)}</div>
                </div>
            `;
        });

        checkoutItems.innerHTML = html;
        document.getElementById('subtotal').textContent = `€${subtotal.toFixed(2)}`;
        document.getElementById('total').textContent = `€${subtotal.toFixed(2)}`;
    }

    document.getElementById('placeOrderBtn').addEventListener('click', async function() {
        const cart = JSON.parse(localStorage.getItem('cart') || '[]');
        
        if (cart.length === 0) {
            alert('Shporta është e zbrazët');
            return;
        }

        this.disabled = true;
        this.innerHTML = '<span>Duke përpunuar...</span>';

        try {
            // Process each item in cart
            for (const item of cart) {
                const response = await fetch('/blej_produktin', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        produkti_id: item.id,
                        sasia: item.sasia,
                        cmimi: item.cmimi
                    })
                });

                const data = await response.json();
                
                if (data.error) {
                    alert(`Gabim: ${data.mesazhi}`);
                    this.disabled = false;
                    this.innerHTML = '<span>Perfundo Porosinë</span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12h14M12 5l7 7-7 7"/></svg>';
                    return;
                }
            }

            // Clear cart
            localStorage.removeItem('cart');
            alert('Porositë u kryen me sukses!');
            window.location.href = '/orders';
        } catch (error) {
            alert('Ndodhi një gabim. Ju lutemi provoni përsëri.');
            this.disabled = false;
            this.innerHTML = '<span>Perfundo Porosinë</span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12h14M12 5l7 7-7 7"/></svg>';
        }
    });

    loadCheckout();
    <% } %>
</script>

<style>
    .checkout-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 3rem 2rem;
        min-height: calc(100vh - 200px);
    }

    .login-required {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 4rem 2rem;
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
    }

    .login-required h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #1f2937;
        margin: 1.5rem 0 0.5rem;
    }

    .login-required p {
        color: #6b7280;
        font-size: 1.1rem;
        margin-bottom: 2rem;
    }

    .auth-buttons {
        display: flex;
        gap: 1rem;
    }

    .btn-login, .btn-register {
        padding: 1rem 2rem;
        border-radius: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s;
    }

    .btn-login {
        background: white;
        color: #0891b2;
        border: 2px solid #0891b2;
    }

    .btn-login:hover {
        background: #f0f9ff;
    }

    .btn-register {
        background: #0891b2;
        color: white;
        border: 2px solid #0891b2;
    }

    .btn-register:hover {
        background: #0e7490;
        transform: translateY(-2px);
    }

    .checkout-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .checkout-header h1 {
        font-size: 2.5rem;
        font-weight: 700;
        color: #0891b2;
        margin-bottom: 0.5rem;
    }

    .checkout-header p {
        font-size: 1.1rem;
        color: #6b7280;
    }

    .checkout-content {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 2rem;
    }

    .checkout-items {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    .checkout-item {
        display: grid;
        grid-template-columns: 100px 1fr 120px;
        gap: 1.5rem;
        align-items: center;
        padding: 1.5rem 0;
        border-bottom: 1px solid #e5e7eb;
    }

    .checkout-item:last-child {
        border-bottom: none;
    }

    .item-image {
        width: 100px;
        height: 100px;
        background-size: cover;
        background-position: center;
        border-radius: 12px;
        background-color: #f9fafb;
    }

    .item-info h4 {
        font-size: 1.1rem;
        font-weight: 600;
        color: #1f2937;
        margin-bottom: 0.5rem;
    }

    .item-info p {
        font-size: 0.9rem;
        color: #6b7280;
        margin: 0.25rem 0;
    }

    .item-price {
        color: #0891b2 !important;
        font-weight: 600 !important;
    }

    .item-total {
        font-size: 1.25rem;
        font-weight: 700;
        color: #1f2937;
        text-align: right;
    }

    .checkout-summary {
        position: sticky;
        top: 2rem;
        height: fit-content;
    }

    .summary-card {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    .summary-card h3 {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 1.5rem;
    }

    .user-info {
        margin-bottom: 1rem;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        padding: 0.75rem 0;
        font-size: 0.95rem;
    }

    .info-row .label {
        color: #6b7280;
        font-weight: 600;
    }

    .info-row .value {
        color: #1f2937;
        font-weight: 500;
    }

    .order-summary {
        margin-top: 1rem;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        padding: 0.75rem 0;
        font-size: 1rem;
        color: #6b7280;
    }

    .summary-row.total {
        font-size: 1.25rem;
        font-weight: 700;
        color: #1f2937;
    }

    .summary-divider {
        height: 1px;
        background: #e5e7eb;
        margin: 1rem 0;
    }

    .place-order-btn {
        width: 100%;
        padding: 1rem;
        background: #0891b2;
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 1.5rem;
        transition: all 0.3s;
    }

    .place-order-btn:hover:not(:disabled) {
        background: #0e7490;
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(8, 145, 178, 0.4);
    }

    .place-order-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .place-order-btn svg {
        stroke-width: 2.5;
    }

    @media (max-width: 1024px) {
        .checkout-content {
            grid-template-columns: 1fr;
        }

        .checkout-summary {
            position: static;
        }
    }

    @media (max-width: 768px) {
        .checkout-container {
            padding: 2rem 1rem;
        }

        .checkout-header h1 {
            font-size: 2rem;
        }

        .checkout-item {
            grid-template-columns: 80px 1fr;
            gap: 1rem;
        }

        .item-image {
            width: 80px;
            height: 80px;
        }

        .item-total {
            grid-column: 2;
            text-align: left;
            margin-top: 0.5rem;
        }

        .auth-buttons {
            flex-direction: column;
            width: 100%;
        }

        .btn-login, .btn-register {
            width: 100%;
        }
    }
</style>

<%- include('footer.ejs') %>
